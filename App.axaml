<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GenericGameLauncher.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EEEEEE" />
                    <SolidColorBrush x:Key="AppForegroundBrush" Color="#252525" />
                    <SolidColorBrush x:Key="AppLinkBrush" Color="#008000" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="AppForegroundBrush" Color="#EBEBEB" />
                    <SolidColorBrush x:Key="AppLinkBrush" Color="#4A9EFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
